<?xml version="1.0" encoding="utf-8"?>
<!--
  Řízená záloha (Android 12+). Zálohují se uživatelská DATA: připomínky,
  oblíbená místa a spravované přílohy. SharedPreferences „georeminder" se
  nezálohují, protože obsahují přechodné schedulerové značky a nastavení,
  jejichž slepá obnova na jiném zařízení by mohla vytvořit chybný stav.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="reminders.json" />
        <include domain="file" path="favorites.json" />
        <include domain="file" path="attachments/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="reminders.json" />
        <include domain="file" path="favorites.json" />
        <include domain="file" path="attachments/" />
    </device-transfer>
</data-extraction-rules>
